{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "printWidth": 80,
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "sortImports": {
    "groups": ["type", "import"],
    "newlinesBetween": true,
    "sortSideEffects": true
  },
  "overrides": [
    {
      "files": [
        "*.css",
        "*.scss",
        "*.html",
        "**/*.css",
        "**/*.scss",
        "**/*.html"
      ],
      "options": {
        "printWidth": 120
      }
    }
  ]
}
